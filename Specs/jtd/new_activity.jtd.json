        "$instruction": {
            "properties": {
                "locale": {
                    "ref": "$locale"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "$gameplay": {
            "enum": [
                "associateCategories",
                "findTheRightAnswers",
                "findTheRightOrder",
                "openPlay"
            ]
        },
        "$exercise_options": {
            "properties": {},
            "optionalProperties": {
                "shuffle_choices": {
                    "type": "boolean"
                },
                "validation": {
                    "ref": "$exercise_validation"
                }
            }
        },
        "$exercise_validation": {
            "discriminator": "type",
            "mapping": {
                "automatic": {
                    "properties": {}
                },
                "manual": {
                    "properties": {},
                    "optionalProperties": {
                        "minimumToSelect": {
                            "type": "float64"
                        },
                        "maximumToSelect": {
                            "type": "float64"
                        }
                    }
                }
            }
        },
        "$action": {
            "discriminator": "type",
            "mapping": {
                "ipad": {
                    "properties": {
                        "value": {
                            "ref": "$action/ipad"
                        }
                    }
                },
                "robot": {
                    "properties": {
                        "value": {
                            "ref": "$action/robot"
                        }
                    }
                }
            }
        },
        "$action/ipad": {
            "discriminator": "type",
            "mapping": {
                "audio": {
                    "properties": {
                        "value": {
                            "type": "string"
                        }
                    }
                },
                "image": {
                    "properties": {
                        "value": {
                            "type": "string"
                        }
                    }
                },
                "sfsymbol": {
                    "properties": {
                        "value": {
                            "type": "string"
                        }
                    }
                },
                "speech": {
                    "properties": {
                        "value": {
                            "elements": {
                                "ref": "$speech_line"
                            }
                        }
                    }
                }
            }
        },
        "$speech_line": {
            "properties": {
                "locale": {
                    "ref": "$locale"
                },
                "utterance": {
                    "type": "string"
                }
            }
        },
        "$action/robot": {
            "discriminator": "type",
            "mapping": {
                "color": {
                    "properties": {
                        "value": {
                            "enum": [
                                "blue",
                                "green",
                                "orange",
                                "purple",
                                "red",
                                "yellow"
                            ]
                        }
                    }
                },
                "image": {
                    "properties": {
                        "value": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "$payload/touchToSelect": {
            "properties": {
                "choices": {
                    "elements": {
                        "ref": "$choice/touchToSelect"
                    }
                }
            }
        },
        "$choice/touchToSelect": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": {
                    "ref": "$choice_type"
                }
            },
            "optionalProperties": {
                "is_right_answer": {
                    "type": "boolean"
                },
                "category": {
                    "ref": "$category"
                }
            }
        },
        "$payload/dragAndDropGrid": {
            "properties": {
                "choices": {
                    "elements": {
                        "ref": "$choice/dragAndDropGrid"
                    }
                }
            }
        },
        "$choice/dragAndDropGrid": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": {
                    "ref": "$choice_type"
                }
            },
            "optionalProperties": {
                "category": {
                    "ref": "$category"
                }
            }
        },
        "$payload/dragAndDropGridWithZones": {
            "properties": {
                "choices": {
                    "elements": {
                        "ref": "$choice/dragAndDropGridWithZones"
                    }
                }
            }
        },
        "$choice/dragAndDropGridWithZones": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": {
                    "ref": "$choice_type"
                }
            },
            "optionalProperties": {
                "category": {
                    "ref": "$category"
                },
                "is_dropzone": {
                    "type": "boolean"
                }
            }
        },
        "$payload/dragAndDropOneToOne": {
            "properties": {
                "choices": {
                    "elements": {
                        "ref": "$choice/dragAndDropOneToOne"
                    }
                }
            }
        },
        "$choice/dragAndDropOneToOne": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": {
                    "ref": "$choice_type"
                }
            },
            "optionalProperties": {
                "state": {
                    "ref": "$state"
                }
            }
        },
        "$payload/memory": {
            "properties": {
                "choices": {
                    "elements": {
                        "ref": "$choice/memory"
                    }
                }
            }
        },
        "$choice/memory": {
            "properties": {
                "value": {
                    "type": "string"
                },
                "type": {
                    "ref": "$choice_type"
                },
                "category": {
                    "ref": "$category"
                }
            }
        },
        "$payload/magicCards": {
            "properties": {
                "choices": {
                    "elements": {
                        "ref": "$choice/magicCard"
                    }
                }
            }
        },
        "$choice/magicCard": {
            "properties": {
                "value": {
                    "type": "string"
                }
            },
            "optionalProperties": {
                "is_right_answer": {
                    "type": "boolean"
                }
            }
        },
        "$payload/musicalInstruments": {
            "properties": {
                "instrument": {
                    "ref": "$instrument"
                },
                "scale": {
                    "ref": "$scale"
                }
            }
        },
        "$payload/melody": {
            "properties": {
                "instrument": {
                    "ref": "$instrument"
                },
                "songs": {
                    "elements": {
                        "ref": "$song"
                    }
                }
            }
        },
        "$payload/danceFreeze": {
            "properties": {
                "songs": {
                    "elements": {
                        "ref": "$song"
                    }
                }
            }
        },
        "$payload/superSimon": {
            "properties": {
                "level": {
                    "enum": [
                        "easy",
                        "hard",
                        "medium"
                    ]
                }
            }
        },
        "$song": {
            "properties": {
                "audio": {
                    "type": "string"
                },
                "labels": {
                    "elements": {
                        "ref": "$song_label"
                    }
                }
            }
        },
        "$song_label": {
            "properties": {
                "locale": {
                    "ref": "$locale"
                },
                "value": {
                    "ref": "$song_label_value"
                }
            }
        },
        "$song_label_value": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "icon": {
                    "type": "string"
                }
            }
        },
        "$choice_type": {
            "enum": [
                "color",
                "emoji",
                "image",
                "sfsymbol"
            ]
        },
        "$category": {
            "enum": [
                "catA",
                "catB",
                "catC",
                "catD"
            ]
        },
        "$state": {
            "enum": [
                "answered",
                "hint",
                "unanswered"
            ]
        },
        "$instrument": {
            "enum": [
                "xylophone"
            ]
        },
        "$scale": {
            "enum": [
                "majorHeptatonic",
                "majorPentatonic"
            ]
        }
    }
}
