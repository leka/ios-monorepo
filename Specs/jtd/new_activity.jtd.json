                "template",
                "thumbs_down",
                "thumbs_up",
                "under",
                "vegetables",
                "weather_elements",
                "wet",
                "winter",
                "yann",
                "zoe"
            ]
        },
        "$activity_type": {
            "enum": [
                "group",
                "one_on_one"
            ]
        },
        "$locale": {
            "enum": [
                "en_US",
                "fr_FR"
            ]
        },
        "$interaction": {
            "properties": {
                "medium": {
                    "enum": [
                        "robot",
                        "tablet",
                        "tablet_robot"
                    ]
                }
            },
            "optionalProperties": {
                "input": {
                    "enum": [
                        "drag_and_drop",
                        "magic_card",
                        "touch_to_select"
                    ]
                },
                "attention": {
                    "enum": [
                        "listen",
                        "look",
                        "mixed"
                    ]
                }
            }
        },
        "$l10n": {
            "properties": {
                "locale": {
                    "ref": "$locale"
                },
                "details": {
                    "ref": "$l10n/details"
                }
            }
        },
        "$l10n/details": {
            "properties": {
                "icon": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "short_description": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "instructions": {
                    "type": "string"
                }
            },
            "optionalProperties": {
                "subtitle": {
                    "type": "string",
                    "nullable": true
                }
            }
        },
        "$payload": {
            "properties": {
                "exercise_groups": {
                    "elements": {
                        "ref": "$exercise_group"
                    }
                }
            },
            "optionalProperties": {
                "options": {
                    "properties": {},
                    "optionalProperties": {
                        "shuffle_exercises": {
                            "type": "boolean"
                        },
                        "shuffle_groups": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "$exercise_group": {
            "properties": {
                "group": {
                    "elements": {
                        "ref": "$exercise"
                    }
                }
            }
        },
        "$exercise": {
            "discriminator": "interface",
            "mapping": {
                "touchToSelect": {
                    "optionalProperties": {
                        "instructions": {
                            "elements": {
                                "ref": "$instruction"
                            }
                        },
                        "gameplay": {
                            "ref": "$gameplay"
                        },
                        "action": {
                            "ref": "$action"
                        },
                        "options": {
                            "ref": "$exercise_options"
                        }
                    },
                    "properties": {
                        "payload": {
                            "ref": "$payload/touchToSelect"
                        }
                    }
                },
                "dragAndDropGrid": {
                    "optionalProperties": {
                        "instructions": {
                            "elements": {
                                "ref": "$instruction"
                            }
                        },
                        "gameplay": {
                            "ref": "$gameplay"
                        },
                        "action": {
                            "ref": "$action"
                        },
                        "options": {
                            "ref": "$exercise_options"
                        }
                    },
                    "properties": {
                        "payload": {
                            "ref": "$payload/dragAndDropGrid"
                        }
                    }
                },
                "dragAndDropGridWithZones": {
                    "optionalProperties": {
                        "instructions": {
                            "elements": {
                                "ref": "$instruction"
                            }
                        },
                        "gameplay": {
                            "ref": "$gameplay"
                        },
                        "action": {
                            "ref": "$action"
                        },
                        "options": {
                            "ref": "$exercise_options"
                        }
                    },
                    "properties": {
