                        "gameplay": {
                            "ref": "$gameplay"
                        },
                        "action": {
                            "ref": "$action"
                        },
                        "options": {
                            "ref": "$exercise_options"
                        }
                    },
                    "properties": {
                        "payload": {
                            "ref": "$payload/dragAndDropOneToOne"
                        }
                    }
                },
                "memory": {
                    "optionalProperties": {
                        "instructions": {
                            "elements": {
                                "ref": "$instruction"
                            }
                        },
                        "gameplay": {
                            "ref": "$gameplay"
                        },
                        "action": {
                            "ref": "$action"
                        },
                        "options": {
                            "ref": "$exercise_options"
                        }
                    },
                    "properties": {
                        "payload": {
                            "ref": "$payload/memory"
                        }
                    }
                },
                "magicCards": {
                    "optionalProperties": {
