{
    "properties": {
        "version": {
            "type": "string"
        },
        "uuid": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "created_at": {
            "type": "string"
        },
        "last_edited_at": {
            "type": "string"
        },
        "status": {
            "ref": "$status"
        },
        "authors": {
            "elements": {
                "ref": "$author"
            }
        },
        "skills": {
            "elements": {
                "ref": "$skill"
            }
        },
        "tags": {
            "elements": {
                "ref": "$tag"
            }
        },
        "interaction": {
            "ref": "$interaction"
        },
        "types": {
            "elements": {
                "ref": "$activity_type"
            }
        },
        "locales": {
            "elements": {
                "ref": "$locale"
            }
        },
        "l10n": {
            "elements": {
                "ref": "$l10n"
            }
        },
        "payload": {
            "ref": "$payload"
        }
    },
    "definitions": {
        "$status": {
            "enum": [
                "published",
                "template"
            ]
        },
        "$author": {
            "enum": [
                "julie_tuil",
                "leka"
            ]
        },
        "$skill": {
            "enum": [
                "association",
                "association/logical",
                "association/matching",
                "association/ordering",
                "association/sorting",
                "attention",
                "attention/joint_attention",
                "attention/sustained_attention",
                "communication",
                "communication/verbal_communication",
                "communication/verbal_communication/receptive_language",
                "communication/verbal_communication/receptive_language/oral_comprehension",
                "counting",
                "emotion_recognition",
                "empathy",
                "familiarization_with_leka",
                "generalization",
                "gross_motor_skills",
                "inhibition",
                "memory",
                "memory/short_term_memory",
                "recognition",
                "relationship_tablet_robot",
                "self_awareness",
                "self_regulation",
                "sensory_integration",
                "sensory_integration/hearing",
                "sensory_integration/touch",
                "sensory_integration/vision",
                "social_interactions",
                "spatial_understanding",
                "time_and_temporality_understanding",
                "turn_taking"
