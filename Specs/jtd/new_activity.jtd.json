                "garden",
                "geometric_shapes",
                "holidays",
                "home_objects",
                "hortense",
                "hot",
                "hugo",
                "in",
                "kitchen",
                "ladislas",
                "leka_pictograms",
                "leka_team",
                "listening",
                "little",
                "louna",
                "lucie",
                "modes_of_transportation",
                "mountain",
                "moussa",
                "music",
                "musical_instruments",
                "next_to",
                "numbers",
                "on",
                "oscar",
                "physiological_needs",
                "pictures",
                "places",
                "professions",
                "quantity",
                "robot_colors",
                "robot_movements",
                "school",
                "sea",
                "seasons",
